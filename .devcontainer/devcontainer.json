version: '3.8'
services:
  postgres-db:
    image: postgres:15-alpine
    container_name: lokalny_postgres
    environment:
      POSTGRES_USER: student
      POSTGRES_PASSWORD: akademickie_haslo
      POSTGRES_DB: uczelnia
    ports:
      - "5432:5432"

  pgadmin:
    image: dpage/pgadmin4
    container_name: lokalny_pgadmin
    environment:
      PGADMIN_DEFAULT_EMAIL: student@uczelnia.pl
      PGADMIN_DEFAULT_PASSWORD: HasloPgAdmina123!
      # Te parametry poniżej są kluczowe, aby pgAdmin działał poprawnie w chmurze GitHub
      PGADMIN_CONFIG_PROXY_X_HOST_COUNT: 1
      PGADMIN_CONFIG_PROXY_X_PREFIX_COUNT: 1
    ports:
      - "5050:80"
    depends_on:
      - postgres-db
